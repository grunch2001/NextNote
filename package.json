{
  "name": "nextnote",
  "productName": "NextNote",
  "version": "1.0.0",
  "description": "OneNote-artige Notiz-App mit Nextcloud-Synchronisierung",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.cjs",
  "author": "Luis Schuster",
  "license": "AGPL-3.0-or-later",
  "repository": "github:grunch2001/NextNote",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "mock-nextcloud": "node tools/mock-nextcloud-server.ts",
    "electron:build-main": "node tools/build-electron.mjs",
    "dist:win": "bash tools/build-windows.sh",
    "android:sync": "npm run build && cap sync android",
    "icons": "node tools/make-icons.mjs",
    "dist:android": "bash tools/build-android.sh",
    "electron:dev": "npm run build && npm run electron:build-main && electron ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "^5.7.284",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "de.luisschuster.nextnote",
    "productName": "NextNote",
    "copyright": "Luis Schuster",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "build-resources/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "NextNote-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "NextNote-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NextNote",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "artifactName": "NextNote-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "de",
      "en-US"
    ]
  }
}
